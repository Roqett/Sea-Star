__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.DS_Store
*.swp

# SeaStar local state — never commit someone's vault index or config
.seastar/
seastar.toml

# Staging folder — documents dropped here for review never ship or commit
INBOX/

# Design reference images — third-party photos (Carpet Sea Star) used only for
# moodboarding the app look. Kept local so a public push never redistributes them.
assets/reference/

# Agent scratch space — anything the editor drops under .trae/ stays local,
# EXCEPT the mac-app spec set, which is a tracked design document (the lodestone).
.trae/*
!.trae/specs/

# macOS app — the Xcode project and Info.plist are generated from macapp/project.yml
# (`xcodegen generate`); regenerate rather than commit them.
macapp/*.xcodeproj/
macapp/*.xcworkspace/
macapp/SeaStar/Support/Info.plist
**/xcuserdata/
**/DerivedData/

# Codex workspace — the autogenerated environment descriptor that wires the
# editor's "Run" action to script/build_and_run.sh. Per-machine scaffolding,
# the same class as .trae/, so it stays local; the script it points at ships.
.codex/